Page Shell
  Stack variant=workspace
    If condition=$settingsPage
      Row variant=settings-header
        Link href="#view=inbox" "← Tasks"
        Spacer
        Button variant=text action=apps "Apps"
    Stack variant=content
      If condition=$error
        Alert tone=error $error
      If condition=$notice
        Alert tone=success $notice
      If condition=$busy
        Row variant=saving
          Spinner
          Text $busy
      Section id=screen-outlet
    If condition=$appsOpen
      Card variant=dialog aria-label="Workspace apps"
        Heading level=2 "Your Workspace apps"
        For each=$appLinks
          Link href=$item.href $item.title
        Button variant=secondary action=closeApps "Close"
